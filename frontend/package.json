{
  "name": "vanguard-breach-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Vanguard-Breach autonomous GenAI red-teaming console (React 19 + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^7.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
